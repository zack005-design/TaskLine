<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_brand" android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open"
            android:textSize="12sp" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/library_widget_title" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/widget_text" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_loading" android:textSize="13sp" android:textColor="@color/widget_secondary" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/widget_task_one" style="@style/WidgetTaskRow" />
    <TextView android:id="@+id/widget_task_two" style="@style/WidgetTaskRow" />
    <TextView android:id="@+id/widget_task_three" style="@style/WidgetTaskRow" />
</LinearLayout>


